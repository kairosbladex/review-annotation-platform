# Copy this file to deploy/production.env and fill every REPLACE_ME value.
# The copied file is ignored by Git. Do not commit production credentials.

DATABASE_URL=postgresql+psycopg://review:REPLACE_ME@postgres.example.internal:5432/review_annotation
REDIS_URL=redis://:REPLACE_ME@redis.example.internal:6379/0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SERVICE_API_KEY=REPLACE_ME

# MinIO SDK endpoint values are host:port, without http:// or https://.
MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET=review-annotation
MINIO_REGION=us-east-1
MINIO_SECURE=true
# This endpoint must be reachable by the operator's browser for presigned URLs.
MINIO_PUBLIC_ENDPOINT=minio.example.internal:9000
MINIO_AUTO_CREATE_BUCKET=false
OBJECT_STORE_REQUIRED=true

# The existing service is called in detection-then-review mode.
MODEL_ADAPTER_TYPE=legacy_review_agent
MODEL_SERVICE_BASE_URL=http://yoloe-review-service.example.internal:8188
MODEL_SERVICE_API_KEY=REPLACE_ME
MODEL_SERVICE_DETECT_ENDPOINT=/api/v1/review-agent/yolo-detect
MODEL_SERVICE_REVIEW_ENDPOINT=/api/v1/review-agent/review
MODEL_SERVICE_VERIFY_TLS=true

API_PORT=8190
FRONTEND_PORT=5173

# Optional semantic descriptions; geometry does not depend on Ollama.
HISTORY_COMPARE_OLLAMA_URL=
HISTORY_COMPARE_MODEL=qwen3.5:9b
HISTORY_COMPARE_TIMEOUT_SECONDS=60
