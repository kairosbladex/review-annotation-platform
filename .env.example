# Copy to .env before `docker compose up` and replace every change-me value.
POSTGRES_DB=review_annotation
POSTGRES_USER=review
POSTGRES_PASSWORD=change-me-postgres-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SERVICE_API_KEY=change-me-service-api-key

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=review-annotation
# Browser-reachable endpoint used for presigned URLs; set the public MinIO host in production.
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000

MODEL_SERVICE_BASE_URL=
MODEL_SERVICE_API_KEY=
