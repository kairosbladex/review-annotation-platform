# Copy to .env before `docker compose up` and replace every change-me value.
POSTGRES_DB=review_annotation
POSTGRES_USER=review
POSTGRES_PASSWORD=change-me-postgres-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SERVICE_API_KEY=change-me-service-api-key

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=review-annotation
MINIO_REGION=us-east-1
MINIO_AUTO_CREATE_BUCKET=true
OBJECT_STORE_REQUIRED=false
# Browser-reachable endpoint used for presigned URLs; set the public MinIO host in production.
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000

MODEL_ADAPTER_TYPE=http
MODEL_SERVICE_BASE_URL=
MODEL_SERVICE_API_KEY=
MODEL_SERVICE_DETECT_ENDPOINT=/api/v1/review-agent/yolo-detect
MODEL_SERVICE_REVIEW_ENDPOINT=/api/v1/review-agent/review
MODEL_SERVICE_VERIFY_TLS=true

# Automatic visual annotation (credentials stay in a gitignored local env file).
AUTO_ANNOTATION_API_KEY=
AUTO_ANNOTATION_BASE_URL=https://sub.butterfly2sea.us
AUTO_ANNOTATION_MODEL=gpt-5.6-luna
AUTO_ANNOTATION_ENDPOINT=/responses
AUTO_ANNOTATION_REASONING_EFFORT=low
AUTO_ANNOTATION_TIMEOUT_SECONDS=120
AUTO_ANNOTATION_VERIFY_TLS=true
AUTO_ANNOTATION_USE_CODEX_CLI=true
AUTO_ANNOTATION_CODEX_BINARY=codex
AUTO_ANNOTATION_ACTOR_AUTHORIZATION=local-image-extension

# Optional: keep original MinIO images at a public HTTP prefix instead of copying bytes.
SOURCE_IMAGE_BASE_URL=
SOURCE_IMAGE_BUCKET=minio-src
SOURCE_IMAGE_VERIFY_TLS=true
