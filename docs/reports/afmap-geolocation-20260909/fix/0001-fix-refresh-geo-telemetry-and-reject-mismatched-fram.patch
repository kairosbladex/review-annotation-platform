@@ -0,0 +1,97 @@
+"""Run candidate handlers in a disposable interpreter using deployed libraries."""
+
+import hashlib
+import json
+import shlex
+import subprocess
+import sys
+from pathlib import Path
+
+
+if "--candidate-stdin" not in sys.argv:
+    root = Path(__file__).resolve().parent
+    remote = "docker exec -i -e PYTHONDONTWRITEBYTECODE=1 overlay-api-2 python -c "
+    remote += shlex.quote(Path(__file__).read_text()) + " --candidate-stdin"
+    result = subprocess.run(
+        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "ai-lingxi", remote],
+        input=(root / "app.py").read_text(), text=True, capture_output=True,
+        timeout=60, check=True,
+    )
+    print(result.stdout, end="")
+    if "--save" in sys.argv:
+        (root / "runtime-validation.json").write_text(result.stdout)
+    raise SystemExit(0)
+
+import asyncio
+from types import ModuleType, SimpleNamespace
+from unittest.mock import patch
+
+import app as deployed
+from fastapi import HTTPException
+
+source = sys.stdin.read()
+candidate = ModuleType("candidate_overlay_app")
+candidate.__file__ = deployed.__file__
+sys.modules[candidate.__name__] = candidate
+exec(compile(source, deployed.__file__, "exec"), candidate.__dict__)
+
+start = 1788775740.0
+old = dict(t_sec=0.0, lat=34.814396, lon=113.476403, alt=203.8, agl_h=109.9,
+           tilt=-90.0, pan=82.8, yaw=81.6, pitch=-4.0, roll=3.4,
+           groundV=5.05, verticalSpeed=0.0, zoomFactor=1.0)
+current = dict(old, t_sec=78.0, lat=34.811697, lon=113.478463,
+               alt=203.81, agl_h=110.0, pan=92.1, yaw=91.6)
+
+
+def check(module):
+    fetches = []
+
+    def fetch(url):
+        fetches.append(url)
+        return ([old] if len(fetches) == 1 else [old, current]), SimpleNamespace(t0=start)
+
+    url = "https://audit.invalid/growing-flight.log"
+    request = module.GeoFromBBoxesRequest(
+        bboxes_xywh=[[33, 346, 28, 42], [270, 374, 25, 75], [598, 83, 267, 31]],
+        image_width=960, image_height=720, log_url=url, shot_time_ms=(start + 78) * 1000,
+        focal_mm=24.0, sensor_w_mm=13.2, sensor_h_mm=8.8, debug=True,
+    )
+    module._get_cached_log_poses.cache_clear()
+    with patch.object(module, "_fetch_log_poses_from_url", fetch):
+        module._get_cached_log_poses(url)
+        result = json.loads(asyncio.run(module.geo_from_bboxes(request)).body)
+    with patch.object(module, "_fetch_log_poses_from_url", lambda url: ([old], SimpleNamespace(t0=start))):
+        try:
+            asyncio.run(module.geo_from_bboxes(request))
+            stale_status = 200
+        except HTTPException as exc:
+            stale_status = exc.status_code
+    return {
+        "sourceFetchCount": len(fetches),
+        "selectedCamera": result["debug_context"]["camera_pose"],
+        "usedTarget": result["debug_context"]["used_target"],
+        "okCount": result["ok_count"],
+        "staleSourceStatus": stale_status,
+    }
+
+
+baseline = check(deployed)
+fixed = check(candidate)
+assert baseline["sourceFetchCount"] == 1
+assert baseline["selectedCamera"]["lon"] == old["lon"]
+assert baseline["staleSourceStatus"] == 200
+assert fixed["sourceFetchCount"] == 2
+assert fixed["selectedCamera"]["lon"] == current["lon"]
+assert fixed["okCount"] == 3
+assert fixed["staleSourceStatus"] == 400
+assert fixed["usedTarget"]["pose_time_delta_sec"] == 0
+print(json.dumps({
+    "scope": "isolated interpreter with deployed dependencies; no HTTP worker changed",
+    "pythonVersion": sys.version,
+    "baselineSha256": hashlib.sha256(Path(deployed.__file__).read_bytes()).hexdigest(),
+    "candidateSha256": hashlib.sha256(source.encode()).hexdigest(),
+    "actualOriginalRequestReplayed": False,
+    "baseline": baseline,
+    "candidate": fixed,
+    "result": "PASS",
+}, indent=2))
