@@ -0,0 +1,165 @@
+"""Exercise the public geo endpoints with a flight log that grows in place."""
+
+from copy import deepcopy
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+from fastapi.testclient import TestClient
+
+from overlay_service import app
+
+
+START = 1788775740.0  # 2026-09-07 18:09:00 +08:00
+LOG_URL = "https://audit.invalid/growing-flight.log"
+OLD = {
+    "t_sec": 0.0, "lat": 34.814396, "lon": 113.476403,
+    "alt": 203.8, "agl_h": 109.9, "tilt": -90.0, "pan": 82.8,
+    "yaw": 81.6, "pitch": -4.0, "roll": 3.4, "groundV": 5.05,
+    "verticalSpeed": 0.0, "zoomFactor": 1.0,
+}
+CURRENT = {
+    **OLD, "t_sec": 78.0, "lat": 34.811697, "lon": 113.478463,
+    "alt": 203.81, "agl_h": 110.0, "pan": 92.1, "yaw": 91.6,
+    "pitch": 4.7, "roll": 4.1, "groundV": 7.1,
+}
+
+
+@pytest.fixture(autouse=True)
+def reset_cache(monkeypatch):
+    monkeypatch.setenv("OVERLAY_LOG_URL_CACHE", "1")
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD, CURRENT]))
+    app._get_cached_log_poses.cache_clear()
+    yield
+    app._get_cached_log_poses.cache_clear()
+
+
+@pytest.fixture
+def client():
+    return TestClient(app.app)
+
+
+def parsed(poses):
+    return deepcopy(poses), SimpleNamespace(t0=START)
+
+
+def payload(batch, seconds=78.0):
+    result = {
+        "log_url": LOG_URL,
+        "shot_time_ms": (START + seconds) * 1000,
+        "image_width": 960, "image_height": 720,
+        "focal_mm": 24.0, "sensor_w_mm": 13.2, "sensor_h_mm": 8.8,
+        "point_mode": "center", "debug": True,
+    }
+    result["bboxes_xywh" if batch else "bbox_xywh"] = (
+        [[33, 346, 28, 42], [270, 374, 25, 75], [598, 83, 267, 31]]
+        if batch else [33, 346, 28, 42]
+    )
+    return result
+
+
+def route(batch):
+    return "/v1/geo/from-bboxes" if batch else "/v1/geo/from-bbox"
+
+
+def context(response, batch):
+    data = response.json()
+    return data["debug_context" if batch else "debug_info"]
+
+
+@pytest.mark.parametrize("batch", [False, True])
+def test_growing_log_uses_new_pose_instead_of_cached_pose(monkeypatch, client, batch):
+    calls = []
+
+    def fetch(url):
+        calls.append(url)
+        return parsed([OLD] if len(calls) == 1 else [OLD, CURRENT])
+
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", fetch)
+    # Prime the cache used by other overlay operations before a geo request.
+    app._get_cached_log_poses(LOG_URL)
+    response = client.post(route(batch), json=payload(batch))
+    assert response.status_code == 200, response.text
+    assert len(calls) == 2
+    debug = context(response, batch)
+    assert debug["camera_pose"]["lon"] == CURRENT["lon"]
+    assert debug["camera_pose"]["lat"] == CURRENT["lat"]
+    assert debug["used_target"]["selected_pose_time_ms"] == (START + 78) * 1000
+    assert debug["used_target"]["pose_time_delta_sec"] == 0
+    if batch:
+        assert response.json()["ok_count"] == 3
+
+
+@pytest.mark.parametrize("batch", [False, True])
+def test_stale_log_is_rejected_before_coordinates_are_returned(monkeypatch, client, batch):
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD]))
+    response = client.post(route(batch), json=payload(batch))
+    assert response.status_code == 400
+    assert "TELEMETRY_TIME_MISMATCH" in response.json()["detail"]
+    assert "78.000" in response.json()["detail"]
+
+
+def test_failed_refresh_does_not_fall_back_to_old_cached_log(monkeypatch, client):
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD]))
+    app._get_cached_log_poses(LOG_URL)
+
+    def failed_fetch(url):
+        raise HTTPException(status_code=400, detail="log source unavailable")
+
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", failed_fetch)
+    assert client.post(route(True), json=payload(True)).status_code == 400
+
+
+@pytest.mark.parametrize("batch", [False, True])
+def test_historical_time_is_matched_within_newly_fetched_complete_log(monkeypatch, client, batch):
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD, CURRENT]))
+    response = client.post(route(batch), json=payload(batch, 0))
+    assert response.status_code == 200
+    assert context(response, batch)["camera_pose"]["lon"] == OLD["lon"]
+
+
+@pytest.mark.parametrize("batch", [False, True])
+def test_time_tolerance_boundary_and_override(monkeypatch, client, batch):
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD]))
+    assert client.post(route(batch), json=payload(batch, 5)).status_code == 200
+    assert client.post(route(batch), json=payload(batch, 5.001)).status_code == 400
+    allowed = {**payload(batch, 6), "max_pose_time_delta_sec": 7.0}
+    response = client.post(route(batch), json=allowed)
+    assert response.status_code == 200
+    assert context(response, batch)["used_target"]["pose_time_delta_sec"] == 6
+
+
+def test_relative_time_is_also_checked(monkeypatch, client):
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD]))
+    request = payload(True)
+    request.pop("shot_time_ms")
+    request["shot_t_sec"] = 78
+    response = client.post(route(True), json=request)
+    assert response.status_code == 400
+    assert "TELEMETRY_TIME_MISMATCH" in response.json()["detail"]
+
+
+def test_stale_mqtt_pose_is_checked_without_falling_back_silently(monkeypatch, client):
+    monkeypatch.setattr(app.mqtt_telemetry, "fetch_poses_sync", lambda *args, **kwargs: parsed([OLD]))
+    response = client.post(route(True), json={**payload(True), "mqtt": {"host": "audit.invalid"}})
+    assert response.status_code == 400
+    assert "TELEMETRY_TIME_MISMATCH" in response.json()["detail"]
+
+
+def test_explicit_pose_index_remains_available_and_reports_selected_time(monkeypatch, client):
+    monkeypatch.setattr(app, "_fetch_log_poses_from_url", lambda url: parsed([OLD, CURRENT]))
+    request = payload(True)
+    request.pop("shot_time_ms")
+    request["pose_index"] = 0
+    response = client.post(route(True), json=request)
+    assert response.status_code == 200
+    used = context(response, True)["used_target"]
+    assert used["selected_pose_time_ms"] == START * 1000
+    assert used["pose_time_delta_sec"] is None
+
+
+@pytest.mark.parametrize("batch", [False, True])
+@pytest.mark.parametrize("limit", [0, -1, "NaN", "Infinity"])
+def test_time_tolerance_must_be_positive_and_finite(client, batch, limit):
+    response = client.post(route(batch), json={**payload(batch), "max_pose_time_delta_sec": limit})
+    assert response.status_code == 422
